# ── Cortex configuration ─────────────────────────────────────────
# Everything below is OPTIONAL. With no file at all, Cortex runs in free
# mode: a keyless community model for text and tools, free image rendering,
# free neural voices, a local video renderer and free web research.

# ── free mode ────────────────────────────────────────────────────
# CORTEX_FREE_MODEL=1                 # 0 = never use the keyless community model
# CORTEX_LOCAL_MODEL=1                # 0 = ignore a local llama.cpp / Ollama server
# CORTEX_LOCAL_URL=http://127.0.0.1:8080/v1
# CORTEX_TTS_VOICE=en-US-AriaNeural   # any Edge neural voice
# CORTEX_IMG_GAP=6                    # seconds between free image requests
# POLLINATIONS_API_KEY=              # optional: higher limits on the free image API

# ── a provider key (unlocks the frontier catalogue; still optional) ──
# AI_GATEWAY_API_KEY=vck_...
# OPENROUTER_API_KEY=sk-or-v1-...    # a $0 key runs the :free models and nothing else
# GEMINI_API_KEY=AIza...             # Google AI Studio: free tier, no card, Gemini Flash
# CORTEX_GOOGLE_RPM=9                # requests/min per Gemini model before Cortex paces itself
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=...
# TOGETHER_API_KEY=...

# ── web research ─────────────────────────────────────────────────
# TAVILY_API_KEY=tvly-...            # free tier; without it: DuckDuckGo + Wikipedia
# BRAVE_API_KEY=...
# CORTEX_SEARX_URL=http://localhost:8888

# ── serving ──────────────────────────────────────────────────────
# PORT=8000
# CORTEX_PASSWORD=choose-a-strong-password
# CORTEX_DATA_DIR=./data
# CORTEX_TOP_K=8
# CORTEX_MAX_TOKENS=1600
# CORTEX_TOOL_ROUNDS=3
# CORTEX_WS_TIMEOUT=20
